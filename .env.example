# ── Required ────────────────────────────────────────────────────────────────
# Claude API key — powers lead scoring, outreach writing, and the daily digest.
# Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# ── Strongly recommended ────────────────────────────────────────────────────
# Where the daily digest email goes (your inbox).
OWNER_EMAIL=coachdan75@gmail.com

# ── Optional: extra lead discovery ──────────────────────────────────────────
# Serper.dev key enables Google search discovery (2,500 free queries).
SERPER_API_KEY=

# ── Optional: email sending ─────────────────────────────────────────────────
# Which system sends outreach emails:
#   "gmail"    - send from your own Gmail/Workspace accounts (one per project
#                if you like) AND monitor those inboxes automatically for
#                replies, bounces and opt-outs. Recommended.
#   "resend"   - simple API sending, low volume, no inbox monitoring.
#   "instantly"- hand leads to an Instantly campaign at scale.
# Without any configured the engine still runs in draft-only mode.
EMAIL_PROVIDER=gmail

# Gmail (EMAIL_PROVIDER=gmail). On each Google account: turn on 2-Step
# Verification, then create an app password (myaccount.google.com/apppasswords)
# and paste it here (16 characters, spaces don't matter).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional: a separate sending identity per project (falls back to the
# primary above). Suffix = product id upper-cased.
GMAIL_ADDRESS_DOC2TRANSLATE=
GMAIL_APP_PASSWORD_DOC2TRANSLATE=
GMAIL_ADDRESS_YT2TRANSLATE=
GMAIL_APP_PASSWORD_YT2TRANSLATE=
GMAIL_ADDRESS_AIMATICX=
GMAIL_APP_PASSWORD_AIMATICX=

# Resend (https://resend.com, 3,000 emails/month free) — used for outreach
# when EMAIL_PROVIDER=resend, and ALWAYS used for your daily digest email.
RESEND_API_KEY=
# Verified sender address in Resend, e.g. dan@yourdomain.com
FROM_EMAIL=

# Instantly (https://instantly.ai) — used when EMAIL_PROVIDER=instantly.
# Generate a v2 API key in Instantly (Settings -> Integrations -> API keys).
# The campaign should have {{personalization}} as its email body and
# {{subject_line}} as its subject; the engine fills both per lead.
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# ── Safety switches ─────────────────────────────────────────────────────────
# "true" = actually send outreach emails automatically (autopilot).
# "false" (default) = draft-only mode; everything waits in the dashboard queue.
SEND_ENABLED=false
# Hard cap on outreach emails per day, even in autopilot.
DAILY_EMAIL_CAP=20
