# ── Required ────────────────────────────────────────────────────────────────
# Claude API key — powers lead scoring, outreach writing, and the daily digest.
# Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# ── Strongly recommended ────────────────────────────────────────────────────
# Where the daily digest email goes (your inbox).
OWNER_EMAIL=coachdan75@gmail.com

# ── Optional: extra lead discovery ──────────────────────────────────────────
# Serper.dev key enables Google search discovery (2,500 free queries).
SERPER_API_KEY=

# ── Optional: email sending (Resend — https://resend.com, 100 emails/day free)
# Without this the engine still runs: it drafts everything and queues it in
# the dashboard for you to copy/send manually.
RESEND_API_KEY=
# Verified sender address in Resend, e.g. dan@yourdomain.com
FROM_EMAIL=

# ── Safety switches ─────────────────────────────────────────────────────────
# "true" = actually send outreach emails automatically (autopilot).
# "false" (default) = draft-only mode; everything waits in the dashboard queue.
SEND_ENABLED=false
# Hard cap on outreach emails per day, even in autopilot.
DAILY_EMAIL_CAP=20
